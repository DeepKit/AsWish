{ ============================================================================
  Test.AsWish.VisualBaseline

  DUnitX tests for Visual Spec Baseline & Deterministic Wireframe Preview
  (WO-20260830-0028).
  Validates:
  1. Deterministic wireframe rendering (same nodes + version -> identical HTML)
  2. Structural wireframe representations (Page -> Section -> Component -> Hierarchy)
  3. Visual preview file output
  4. Accepted Visual Baseline creation with snapshot, decision, and visual binding
  5. Immutability of historical visual baseline
  6. Context pack export of visual baseline
  ============================================================================ }

unit Test.AsWish.VisualBaseline;

interface

uses
  DUnitX.TestFramework,
  System.SysUtils,
  System.Classes,
  System.IOUtils,
  System.Generics.Collections,
  AsWish.Models,
  AsWish.Hash,
  AsWish.Services.SpecStore,
  AsWish.Services.Snapshot,
  AsWish.Services.Render,
  AsWish.Services.Decisions,
  AsWish.Services.Context;

type
  [TestFixture]
  TTestAsWishVisualBaseline = class
  private
    FTestDir: string;
    FStore: TAsWishStoreService;
    FSnapshot: TAsWishSnapshotService;
    FRender: TAsWishRenderService;
    function MakeViewNode(const AId, ATitle, AKind, AParentId, ASummary: string): TSpecNode;
  public
    [Setup]
    procedure SetUp;
    [TearDown]
    procedure TearDown;

    [Test]
    procedure Test01_VisualPreview_DeterministicRendering;
    [Test]
    procedure Test02_VisualPreview_GeneratesStructureWireframe;
    [Test]
    procedure Test03_VisualPreview_RendersToFile;
    [Test]
    procedure Test04_VisualBaseline_BindingToSnapshotAndDecision;
    [Test]
    procedure Test05_VisualBaseline_ImmutableHistorical;
    [Test]
    procedure Test06_VisualBaseline_ContextPackExport;
  end;

implementation

{ TTestAsWishVisualBaseline }

function TTestAsWishVisualBaseline.MakeViewNode(const AId, ATitle, AKind,
  AParentId, ASummary: string): TSpecNode;
begin
  Result := Default(TSpecNode);
  Result.Id := AId;
  Result.Title := ATitle;
  Result.Kind := AKind;
  Result.ParentId := AParentId;
  Result.Summary := ASummary;
  Result.Status := nsConfirmed;
  Result.Confidence := clHigh;
  Result.SourceLayer := slHumanDecision;
  Result.ContentHash := TSpecHash.NodeContentHash(Result);
  Result.RelationHash := TSpecHash.NodeRelationHash(Result);
end;

procedure TTestAsWishVisualBaseline.SetUp;
begin
  FTestDir := TPath.Combine(TPath.GetTempPath, 'aswish-visual-test-' + TGuid.NewGuid.ToString.Substring(1, 8));
  TDirectory.CreateDirectory(FTestDir);
  FStore := TAsWishStoreService.Create;
  FStore.Initialize(FTestDir);
  FStore.CreateDirectoryStructure;
  FSnapshot := TAsWishSnapshotService.Create(FStore);
  FRender := TAsWishRenderService.Create;
  FRender.Initialize(TPath.Combine(FTestDir, '.AsWish'));
end;

procedure TTestAsWishVisualBaseline.TearDown;
begin
  FRender.Free;
  FSnapshot.Free;
  FStore.Free;
  if TDirectory.Exists(FTestDir) then
    TDirectory.Delete(FTestDir, True);
end;

procedure TTestAsWishVisualBaseline.Test01_VisualPreview_DeterministicRendering;
var
  LNodes1, LNodes2: TList<TSpecNode>;
  LFile1, LHtml1, LHtml2: string;
begin
  LNodes1 := TList<TSpecNode>.Create;
  LNodes2 := TList<TSpecNode>.Create;
  try
    LNodes1.Add(MakeViewNode('view-main', 'Main Dashboard', 'page', '', 'Top-level application window'));
    LNodes1.Add(MakeViewNode('view-nav', 'Header Navbar', 'section', 'view-main', 'Navigation bar with search and actions'));
    LNodes1.Add(MakeViewNode('view-search', 'Search Input', 'component', 'view-nav', 'Quick search input box'));

    LNodes2.Add(MakeViewNode('view-main', 'Main Dashboard', 'page', '', 'Top-level application window'));
    LNodes2.Add(MakeViewNode('view-nav', 'Header Navbar', 'section', 'view-main', 'Navigation bar with search and actions'));
    LNodes2.Add(MakeViewNode('view-search', 'Search Input', 'component', 'view-nav', 'Quick search input box'));

    LFile1 := TPath.Combine(FTestDir, '.AsWish\html\visual-preview.html');
    FRender.RenderVisualPreview(LNodes1, 'DemoProject', 'wireframe-v1.0');
    LHtml1 := TFile.ReadAllText(LFile1, TEncoding.UTF8);

    // Strip dynamic timestamp in footer for pure deterministic content comparison
    var LPos1 := Pos('Generated by AsWish at', LHtml1);
    if LPos1 > 0 then LHtml1 := Copy(LHtml1, 1, LPos1);

    FRender.RenderVisualPreview(LNodes2, 'DemoProject', 'wireframe-v1.0');
    LHtml2 := TFile.ReadAllText(LFile1, TEncoding.UTF8);
    var LPos2 := Pos('Generated by AsWish at', LHtml2);
    if LPos2 > 0 then LHtml2 := Copy(LHtml2, 1, LPos2);

    Assert.AreEqual(LHtml1, LHtml2, 'Same View Spec + Renderer Version must produce 100% deterministic HTML');
  finally
    LNodes1.Free;
    LNodes2.Free;
  end;
end;

procedure TTestAsWishVisualBaseline.Test02_VisualPreview_GeneratesStructureWireframe;
var
  LNodes: TList<TSpecNode>;
  LFile, LHtml: string;
begin
  LNodes := TList<TSpecNode>.Create;
  try
    LNodes.Add(MakeViewNode('view-login', 'Login Form', 'page', '', 'Authentication screen'));
    LNodes.Add(MakeViewNode('view-card', 'Credentials Card', 'section', 'view-login', 'Card containing input controls'));
    LNodes.Add(MakeViewNode('view-btn-submit', 'Submit Button', 'component', 'view-card', 'Triggers login flow'));

    FRender.RenderVisualPreview(LNodes, 'DemoApp', 'wireframe-v1.0');

    LFile := TPath.Combine(FTestDir, '.AsWish\html\visual-preview.html');
    Assert.IsTrue(TFile.Exists(LFile), 'visual-preview.html must be generated');
    LHtml := TFile.ReadAllText(LFile, TEncoding.UTF8);

    Assert.IsTrue(LHtml.Contains('wf-page'), 'HTML must contain page container class');
    Assert.IsTrue(LHtml.Contains('wf-section'), 'HTML must contain section container class');
    Assert.IsTrue(LHtml.Contains('wf-component'), 'HTML must contain component class');
    Assert.IsTrue(LHtml.Contains('view-login'), 'HTML must contain root node ID');
    Assert.IsTrue(LHtml.Contains('view-card'), 'HTML must contain child section ID');
    Assert.IsTrue(LHtml.Contains('view-btn-submit'), 'HTML must contain leaf component ID');
    Assert.IsTrue(LHtml.Contains('wireframe-v1.0'), 'HTML must display renderer version');
  finally
    LNodes.Free;
  end;
end;

procedure TTestAsWishVisualBaseline.Test03_VisualPreview_RendersToFile;
var
  LNodes: TList<TSpecNode>;
  LFile: string;
begin
  LNodes := TList<TSpecNode>.Create;
  try
    LNodes.Add(MakeViewNode('view-001', 'Test View', 'page', '', 'Test'));
    FRender.RenderVisualPreview(LNodes, 'TestProj');
    LFile := TPath.Combine(FTestDir, '.AsWish\html\visual-preview.html');
    Assert.IsTrue(TFile.Exists(LFile), 'visual-preview.html must exist on disk');
  finally
    LNodes.Free;
  end;
end;

procedure TTestAsWishVisualBaseline.Test04_VisualBaseline_BindingToSnapshotAndDecision;
var
  LViewNodes: TList<TSpecNode>;
  LDec: TSpecDecision;
  LCS: TChangeSet;
  LBaseline, LLoaded: TAsWishBaseline;
  LBaseId: string;
begin
  LViewNodes := TList<TSpecNode>.Create;
  try
    LViewNodes.Add(MakeViewNode('view-main', 'Main View', 'page', '', 'Top view'));
    FStore.WriteTreeFile('trees/view-tree.yaml', ttView, LViewNodes);

    LDec := Default(TSpecDecision);
    LDec.Id := 'dec-vis-001';
    LDec.DecisionType := dtConfirm;
    LDec.Title := 'Accepted Visual Baseline for View Spec';
    LDec.Status := dsAccepted;
    LDec.DecidedBy := dbHuman;

    LCS := TChangeSet.CreateNew('cs-vis-001', 'view-main', ttView, 'Confirm view layout', 'human');

    LBaseId := FSnapshot.CreateBaseline(LDec, LCS, nil, nil, LViewNodes, nil,
      LBaseline, 'wireframe-v1.0', 'html/visual-preview.html');

    Assert.IsTrue(LBaseId.StartsWith('B-'), 'Baseline ID should start with B-');
    Assert.AreEqual('wireframe-v1.0', LBaseline.RendererVersion, 'Baseline must record renderer version');
    Assert.AreEqual('html/visual-preview.html', LBaseline.VisualBinding, 'Baseline must record visual binding path');
    Assert.AreEqual('view', LBaseline.TreeType, 'TreeType must be view');

    Assert.IsTrue(FSnapshot.LoadBaseline(LBaseId, LLoaded));
    Assert.AreEqual('wireframe-v1.0', LLoaded.RendererVersion);
    Assert.AreEqual('html/visual-preview.html', LLoaded.VisualBinding);
    Assert.AreEqual('dec-vis-001', LLoaded.DecisionId);
  finally
    LViewNodes.Free;
  end;
end;

procedure TTestAsWishVisualBaseline.Test05_VisualBaseline_ImmutableHistorical;
var
  LViewNodes: TList<TSpecNode>;
  LDec: TSpecDecision;
  LCS: TChangeSet;
  LBaseline, LLoaded: TAsWishBaseline;
  LBaseId: string;
  LOriginalContentHash: string;
begin
  LViewNodes := TList<TSpecNode>.Create;
  try
    LViewNodes.Add(MakeViewNode('view-01', 'Original View', 'page', '', 'Initial design'));
    FStore.WriteTreeFile('trees/view-tree.yaml', ttView, LViewNodes);

    LDec := Default(TSpecDecision);
    LDec.Id := 'dec-vis-hist';
    LDec.Status := dsAccepted;

    LCS := TChangeSet.CreateNew('cs-vis-hist', 'view-01', ttView, 'Initial confirm', 'human');

    LBaseId := FSnapshot.CreateBaseline(LDec, LCS, nil, nil, LViewNodes, nil,
      LBaseline, 'wireframe-v1.0', 'html/visual-preview.html');
    LOriginalContentHash := LBaseline.ContentHash;

    // Mutate live View Spec
    LViewNodes.Clear;
    LViewNodes.Add(MakeViewNode('view-01', 'Changed View', 'page', '', 'Drastically changed design'));
    FStore.WriteTreeFile('trees/view-tree.yaml', ttView, LViewNodes);

    // Verify historical visual baseline remains unchanged
    Assert.IsTrue(FSnapshot.VerifyBaseline(LBaseId), 'Historical visual baseline must pass verification');
    Assert.IsTrue(FSnapshot.LoadBaseline(LBaseId, LLoaded));
    Assert.AreEqual(LOriginalContentHash, LLoaded.ContentHash, 'ContentHash must not change for historical baseline');
  finally
    LViewNodes.Free;
  end;
end;

procedure TTestAsWishVisualBaseline.Test06_VisualBaseline_ContextPackExport;
var
  LBaselines: TArray<TAsWishBaseline>;
  LContextSrc: TBaselineContextSource;
  LChunks: TArray<TContextChunk>;
  LAssembler: TContextAssembler;
  LOutput: string;
begin
  SetLength(LBaselines, 1);
  LBaselines[0] := TAsWishBaseline.CreateNew('B-0001', 'dec-0001', 'snap-0001', 'view',
    'hash123', 'rel456', TBaselineLineage.CreateNew('cs-001', 'intent-001'),
    'wireframe-v1.0', 'html/visual-preview.html');

  LContextSrc := TBaselineContextSource.Create(LBaselines, 1);
  LChunks := LContextSrc.Collect;

  Assert.AreEqual(1, Integer(Length(LChunks)), 'Should collect 1 chunk for baselines');
  Assert.IsTrue(LChunks[0].Content.Contains('B-0001'), 'Chunk must contain Baseline ID');
  Assert.IsTrue(LChunks[0].Content.Contains('wireframe-v1.0'), 'Chunk must contain renderer version');
  Assert.IsTrue(LChunks[0].Content.Contains('html/visual-preview.html'), 'Chunk must contain visual binding');

  LAssembler := TContextAssembler.Create;
  try
    LAssembler.AddSource(LContextSrc);
    LOutput := LAssembler.Assemble;
    Assert.IsTrue(LOutput.Contains('Accepted Baselines & Visual Baselines'), 'Assembled context pack must include visual baseline section');
    Assert.IsTrue(LOutput.Contains('B-0001'), 'Assembled output must contain baseline details');
  finally
    LAssembler.Free;
  end;
end;

initialization
  TDUnitX.RegisterTestFixture(TTestAsWishVisualBaseline);

end.
