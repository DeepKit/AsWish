# Delphi sources: LF-only in the repo, checked out as-is.
# The repo predates this file, which is why WO-20260925-0055 E1 recorded a
# 2373-line commit whose only real change was line endings.
*.pas text eol=lf
*.dpr text eol=lf
*.inc text eol=lf

# Not part of a source release: internal governance and work-order artefacts.
# WO/ holds work orders, audit requests and test logs that reference other
# private projects and decisions awaiting the owner; .workbuddy/ holds daily
# working logs. They stay in the repository on purpose - they are internal
# assets, not deletions. `git archive` is how a source release is built, and it
# honours export-ignore.
WO/                export-ignore
.workbuddy/        export-ignore
.AsWish/           export-ignore
.ai-workbench/     export-ignore
_repro/            export-ignore
_audit_out.txt     export-ignore
_audit_err.txt     export-ignore
err_file           export-ignore
out_file           export-ignore
AGENTS.md          export-ignore

# Internal audit / handover / onboarding material that lives outside WO/. Found
# while verifying the export list: the numbered docs under docs/ are product and
# engineering specs meant to be public, but docs/归档/ (146 files), the session
# handover note and the product-manager onboarding pack are not, and one audit
# request was sitting at the repository root. All excluded by pattern below.
docs/归档/         export-ignore
docs/_archive/     export-ignore
docs/*交接*         export-ignore
docs/*交接包*       export-ignore
AUDIT-REQUEST-*    export-ignore

src/services/AsWish.Binding.HB.pas -text diff
src/services/AsWish.Services.VisualWorkflow.pas -text diff
tests/Test.AsWish.VisualWorkflow.Evolution.pas -text diff
